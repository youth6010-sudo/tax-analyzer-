{
  "name": "tax-analyzer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node --max-old-space-size=8192 node_modules/next/dist/bin/next dev --webpack -H 0.0.0.0 -p 3000",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:lan": "node --max-old-space-size=8192 node_modules/next/dist/bin/next dev --webpack -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000",
    "start:lan": "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000",
    "stable": "npm run build && npm run start",
    "host:office": "powershell -ExecutionPolicy Bypass -File scripts/office-host-run.ps1",
    "host:office:setup": "powershell -ExecutionPolicy Bypass -File scripts/office-host-setup.ps1",
    "relay:bluehole": "node scripts/bluehole-relay.mjs",
    "relay:office": "powershell -ExecutionPolicy Bypass -File scripts/relay-run.ps1",
    "relay:office:setup": "powershell -ExecutionPolicy Bypass -File scripts/relay-setup.ps1",
    "lint": "eslint",
    "import:contacts": "node scripts/import-contacts.mjs",
    "delete:damdang-excel": "node scripts/delete-damdang-excel.mjs",
    "import:youth-id": "node scripts/import-youth-id.mjs",
    "import:youth-workbook": "node scripts/import-youth-workbook.mjs",
    "import:youth-workbook:link": "node scripts/import-youth-workbook.mjs --link-only",
    "import:suimcheo": "node scripts/import-suimcheo.mjs --replace",
    "import:douzone-contacts": "node scripts/import-douzone-contacts.mjs",
    "import:all": "node scripts/import-all.mjs",
    "import:verify-clients": "node scripts/verify-client-import.mjs",
    "db:ensure-bluehole-log-action": "node scripts/ensure-bluehole-sync-log-action.mjs",
    "db:ensure-nts-columns": "node scripts/ensure-nts-columns.mjs",
    "db:ensure-filing-tables": "node scripts/ensure-filing-tables.mjs",
    "db:migrate-income-types": "node scripts/migrate-income-types.mjs",
    "db:push": "node scripts/db-push-env.mjs",
    "db:ensure-calendar-tables": "node scripts/ensure-calendar-tables.mjs",
    "db:ensure-mail-receipts": "node scripts/ensure-mail-receipts.mjs",
    "db:ensure-menu-prefs": "node scripts/ensure-menu-prefs.mjs",
    "db:seed": "node scripts/seed-users.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:wipe-clients": "node scripts/wipe-all-client-data.mjs --confirm",
    "db:migrate-contacts": "node scripts/migrate-contacts-to-db.mjs",
    "import:lunch": "node scripts/import-lunch.mjs",
    "git:commit": "node scripts/dev-commit.cjs",
    "docker:up": "docker compose up --build",
    "vercel:login": "npx vercel@latest login",
    "vercel:link": "npx vercel@latest link",
    "vercel:deploy": "npx vercel@latest deploy --prod",
    "vercel:sync-db": "node scripts/sync-supabase-vercel.mjs",
    "db:ensure-review-tables": "node scripts/ensure-review-tables.mjs",
    "rebuild:company-index": "npx tsx scripts/rebuild-company-index.ts",
    "migrate:review-links": "npx tsx scripts/migrate-review-client-links.ts",
    "rebuild:review-links": "npx tsx scripts/rebuild-review-client-links.ts",
    "auto-link:review": "npx tsx scripts/run-auto-link-review.ts",
    "import:review": "python scripts/import-review-grid.py --output public/data/review-grid.json",
    "db:import-review-sheets": "node scripts/import-review-to-db.mjs",
    "import:review:full": "npm run import:review && npm run db:import-review-sheets",
    "sync:review-assets": "node scripts/sync-review-assets.mjs",
    "verify:review": "node scripts/verify-review-integration.mjs",
    "db:compare-env": "node scripts/compare-db-env.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dom-to-image-more": "^3.7.2",
    "drizzle-orm": "^0.45.2",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.2",
    "iron-session": "^8.0.4",
    "jspdf": "^4.2.1",
    "next": "16.2.6",
    "pdfjs-dist": "^5.7.284",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "dugite": "^3.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

# Optional: colleague PCs' IPv4 when using npm run dev / dev:lan (comma-separated)
# ALLOWED_DEV_ORIGINS=192.168.0.11,192.168.0.12

# 청년들 ID — 회사 계정/계좌 (DB 우선, 이 JSON은 초기/백업)
# 포털 /youth-ids 에서 편집하면 app_config(youth_ids)에 저장됩니다.
# Vercel 환경변수 YOUTH_IDS_JSON 은 DB가 비어 있을 때만 사용.
# 접근: YOUTH_IDS_ALLOWED_IPS + 로그인. owner 없으면 공용, 있으면 해당 닉네임(+전체보기 권한자).
# secret:true 필드는 기본 가림 + 클릭 보기.

# 부산지점 포털 — Postgres + 세션
# DATABASE_URL=postgresql://...   (운영: Supabase Seoul pooler 권장)
# Supabase 컷오버 준비 시(결제 후, 전환 전) 새 URL만 먼저 넣어 둠:
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[pw]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
#   → npm run db:prep-supabase / db:migrate-to-supabase / rewrite-env-to-supabase.mjs
# SESSION_SECRET=32자 이상 랜덤 문자열

# Supabase Storage (우편물 사진) — Settings → API
# SUPABASE_URL 미설정 시 DATABASE_URL의 project ref로 https://<ref>.supabase.co 추론
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (절대 클라이언트에 넣지 말 것)

# 블루홀 연동 — 담당자별 계정은 앱 설정에서 등록(DB에 AES-GCM 암호화 저장).
# BLUEHOLE_ENC_KEY 는 비밀번호 암호화 키(필수, 배포 전 환경마다 동일 값 유지).
#   생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BLUEHOLE_ENC_KEY=64자리hex
# (선택) 자격증명 미등록 사용자용 폴백 단일계정
# BLUEHOLE_LOGIN_ID=you@example.com
# BLUEHOLE_PASSWORD=비밀번호

# Kakao Local API — npm run import:lunch (맛집 JSON 자동 생성)
# 발급: docs/맛집-등록-가이드.md
# KAKAO_REST_KEY=
# OFFICE_LAT=37.5012
# OFFICE_LNG=127.0396
# OFFICE_LABEL=우리 사무실
# LUNCH_SEARCH_RADIUS=2000

# 국세청 사업자등록 상태조회/진위확인 (공공데이터포털 15081808)
#   data.go.kr 활용신청 후 발급되는 일반 인증키(Decoding) 권장.
#   거래처 상세 "국세청 조회" / 대시보드 "국세청 일괄 점검" / 진위확인에 사용.
# NTS_SERVICE_KEY=

# Vercel Cron(주간 국세청 자동 점검, /api/cron/nts-refresh) 인증용 시크릿.
#   Vercel Production에서는 필수(미설정 시 cron 거부). 로컬 개발만 생략 가능.
#   설정 시 Vercel Cron 호출에 Authorization: Bearer <CRON_SECRET> 가 자동 첨부됨.
#   생성 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=

# 청년들 ID 페이지 — 회사 공인 IP(쉼표 구분). Production에서 비어 있으면 전원 차단.
# YOUTH_IDS_ALLOWED_IPS=1.2.3.4,5.6.7.8
# 초기 JSON(DB app_config.youth_ids 가 비어 있을 때만). 형식: docs/youth-ids.example.json
# YOUTH_IDS_JSON={"categories":[]}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local db backups (수임처 재반영 전 스냅샷 — 민감정보 포함, 커밋 금지)
/backups

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local scratch / PDF·불일치 덤프 (민감·대용량 — 커밋 금지)
.tmp-*
tmp-ledger-*
tmp-*.json
tmp-*.txt
scripts/.*
!scripts/.gitkeep
scripts/__pycache__/
*.pyc
.cache/